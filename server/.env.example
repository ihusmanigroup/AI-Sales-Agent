# ============================================================
# AgentHack Autonomous AI Sales Agent — Environment Template
# Copy to `.env` and fill in real values. Never commit `.env`.
# ============================================================

# ---- Server ----
PORT=5000

# ---- Database (PostgreSQL / Supabase pooler) ----
DATABASE_URL="postgresql://user:password@host:6543/postgres"
SUPABASE_URL="https://your-project.supabase.co"

# ---- LLM (Groq primary, Gemini fallback) ----
GROQ_API_KEY=
GROQ_PRIMARY_MODEL=llama-3.3-70b-versatile
GROQ_MINI_MODEL=llama-3.1-8b-instant
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ---- Web research (optional; if empty, demo/simulation fallback is used) ----
TAVILY_API_KEY=
SERPER_API_KEY=

# ---- Email (optional; if empty, outreach is simulated) ----
RESEND_API_KEY=
EMAIL_SENDER="AgentHack Sales <sales@yourdomain.com>"

# ---- Calendar (optional; if empty, meetings are simulated) ----
GOOGLE_CALENDAR_CLIENT_EMAIL=
GOOGLE_CALENDAR_PRIVATE_KEY=

# ---- Admin WhatsApp (optional; if empty, admin notifications are simulated) ----
# Twilio WhatsApp sender and your admin's WhatsApp number (E.164, e.g. +15551234567)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"
ADMIN_WHATSAPP_TO=

# ---- System controls ----
# DEMO_MODE=true => deterministic seeded workflow, no external calls
DEMO_MODE=false
# Master outbound kill switch. false blocks all outreach dispatch.
OUTBOUND_ENABLED=true
# Follow-up cadence (days between touches)
FOLLOWUP_DAY_1=0
FOLLOWUP_DAY_2=3
# Default availability window for simulated meetings (local HH:MM)
MEETING_DEFAULT_HOUR=15